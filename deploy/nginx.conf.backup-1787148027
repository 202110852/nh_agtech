    server {
        listen 443 ssl;
        http2 on;
        server_name webos.lkim.me;

        ssl_certificate     /Users/lkim/letsencrypt/config/live/webos.lkim.me/fullchain.pem;
        ssl_certificate_key /Users/lkim/letsencrypt/config/live/webos.lkim.me/privkey.pem;

        # Vite dev server sends many parallel module requests;
        # rate limiting causes 503 on page load — skip it here.

        # MCP server (Streamable HTTP) — WebOS tools for AI clients.
        # Auth is pass-through: the client's Bearer token is forwarded to the API.
        location /mcp {
            proxy_pass http://127.0.0.1:4452;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header Connection '';
            # SSE streaming: don't buffer, allow long-lived responses.
            proxy_buffering off;
            chunked_transfer_encoding on;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
        }

        location / {
            proxy_pass http://127.0.0.1:4450;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
        }
    }

    server {
        listen 443 ssl;
        http2 on;
        server_name api.webos.lkim.me;

        ssl_certificate     /Users/lkim/letsencrypt/config/live/webos.lkim.me/fullchain.pem;
        ssl_certificate_key /Users/lkim/letsencrypt/config/live/webos.lkim.me/privkey.pem;

        include /opt/homebrew/etc/nginx/security.conf;

        client_max_body_size 500m;
        # A 500MB upload from a phone can pause between reads; the 60s default
        # would abort a slow-but-alive connection midway.
        client_body_timeout 300s;

        error_page 413 = @too_large;

        # Rate-limit auth endpoints against brute force (10/min + small burst).
        location = /api/v1/auth/login {
            limit_req zone=authlimit burst=5 nodelay;
            proxy_pass http://[::1]:4451;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }
        location = /api/v1/auth/register {
            limit_req zone=authlimit burst=3 nodelay;
            proxy_pass http://[::1]:4451;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }

        # Phone agent doorbell — the socket is silent between requests, so the
        # default 120s read cap would drop it every two minutes and leave the
        # phone in a permanent reconnect loop.
        location /api/v1/mobile-agent/ws {
            proxy_pass http://[::1]:4451;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_buffering off;
            proxy_read_timeout 86400s;
            proxy_send_timeout 86400s;
        }

        # Live media relay — a viewer's socket can idle between chunks and the
        # default 120s read cap would drop it mid-broadcast.
        location /api/v1/streams/ws {
            proxy_pass http://[::1]:4451;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_buffering off;
            proxy_read_timeout 86400s;
            proxy_send_timeout 86400s;
        }

        # Interactive SSH PTY WebSocket — long-lived, unbuffered, no idle cap so
        # the terminal stays open. (The default location below caps reads at 120s.)
        location /api/v1/sshterm/ws {
            proxy_pass http://[::1]:4451;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_buffering off;
            proxy_read_timeout 86400s;
            proxy_send_timeout 86400s;
        }

        location / {
            proxy_pass http://[::1]:4451;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;

            proxy_read_timeout 120s;
            proxy_send_timeout 120s;

            proxy_intercept_errors on;
            # nginx drops inherited error_page entries as soon as a level
            # defines its own, so the server-level 413 handler has to be
            # repeated here or an oversize upload falls back to nginx's default
            # HTML page — which carries no CORS header, so the browser reports a
            # bare "Network Error" instead of the size limit.
            error_page 413 = @too_large;
            error_page 502 503 504 = @cors_error;
        }

        location @cors_error {
            add_header Access-Control-Allow-Origin "https://webos.lkim.me" always;
            add_header Access-Control-Allow-Credentials "true" always;
            add_header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS, PATCH" always;
            add_header Access-Control-Allow-Headers "Authorization, Content-Type" always;
            return 502 '{"detail":"Server temporarily unavailable"}';
        }

        location @too_large {
            add_header Access-Control-Allow-Origin "https://webos.lkim.me" always;
            add_header Access-Control-Allow-Credentials "true" always;
            add_header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS, PATCH" always;
            add_header Access-Control-Allow-Headers "Authorization, Content-Type" always;
            return 413 '{"detail":"File too large (max 500MB)"}';
        }
    }

